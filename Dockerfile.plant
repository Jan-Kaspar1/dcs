# syntax=docker/dockerfile:1

# Build stage: compile the plant server with the workspace-pinned toolchain.
FROM rust:1.98.1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p dcs-plant

# Runtime stage: minimal image carrying only the plant server binary.
FROM debian:bookworm-slim AS runtime
RUN useradd --no-create-home --shell /usr/sbin/nologin --uid 10001 dcs
COPY --from=build /src/target/release/dcs-plant-server /usr/local/bin/dcs-plant-server
USER dcs
ENTRYPOINT ["dcs-plant-server"]
CMD ["--help"]
