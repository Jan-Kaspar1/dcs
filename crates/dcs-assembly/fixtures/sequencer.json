    {
      "id": 11,
      "direction": "in",
      "value_type": "bool",
      "channel": { "device": 1, "name": "reset" }
    },
    {
      "id": 20,
      "direction": "out",
      "value_type": "float",
      "channel": { "device": 1, "name": "out" }
    },
    {
      "id": 21,
      "direction": "out",
      "value_type": "int",
