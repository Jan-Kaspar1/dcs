    },
    {
      "id": 11,
      "direction": "in",
      "value_type": "Float",
      "channel": { "device": 1, "name": "level-raw" }
    },
    {
      "id": 12,
      "direction": "out",
      "value_type": "Float",
      "channel": { "device": 1, "name": "valve" }
