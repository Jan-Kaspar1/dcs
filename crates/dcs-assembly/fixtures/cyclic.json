    },
    {
      "id": 103,
      "name": "timed-output",
      "source": 20,
      "description": "Timer output asserted after three consecutive scans"
    },
    {
      "id": 104,
      "name": "batch-count",
      "source": 21,
      "description": "Rising edges counted toward the preset"
    },
    {
      "id": 105,
      "name": "batch-done",
      "source": 22,
      "description": "Counter preset-reached flag"
    },
    {
      "id": 106,
      "name": "ramped-output",
      "source": 23,
      "unit": "%",
      "description": "Slew-bounded analog output"
    }
