      "id": 100,
      "name": "pulse-train",
      "source": 10,
      "description": "Field pulse the timer and counter observe"
    },
    {
      "id": 101,
      "name": "counter-reset",
      "source": 11,
      "description": "Operator reset for the batch counter"
