      "id": 10,
      "direction": "in",
      "value_type": "Bool",
      "channel": { "device": 1, "name": "pulse" }
    },
    {
      "id": 11,
      "direction": "in",
      "value_type": "Bool",
      "channel": { "device": 1, "name": "reset" }
    },
    {
      "id": 12,
      "direction": "in",
      "value_type": "Float",
      "channel": { "device": 1, "name": "target" }
    },
    {
      "id": 20,
      "direction": "out",
      "value_type": "Bool",
      "channel": { "device": 1, "name": "timed" }
    },
    {
      "id": 21,
      "direction": "out",
      "value_type": "Int",
      "channel": { "device": 1, "name": "count" }
    },
    {
      "id": 22,
      "direction": "out",
