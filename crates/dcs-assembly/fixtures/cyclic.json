      "from": { "port": { "component": 1, "name": "out" } },
      "to": { "point": 20 }
    },
    {
      "from": { "port": { "component": 2, "name": "count" } },
      "to": { "point": 21 }
    },
    {
      "from": { "port": { "component": 2, "name": "done" } },
      "to": { "point": 22 }
    },
    {
      "from": { "port": { "component": 3, "name": "out" } },
      "to": { "point": 23 }
