{
  "version": 1,
  "devices": [
    {
      "id": 1,
      "kind": "sim",
      "channels": {
        "setpoint": { "direction": "in", "value_type": "float" },
        "valve": { "direction": "out", "value_type": "float" }
      }
    },
    {
      "id": 2,
      "kind": "sim-tcp",
      "parameters": { "address": "__PLANT_ADDR__" },
      "channels": {
        "level-raw": { "direction": "in", "value_type": "float" }
      }
    }
  ],
  "io_points": [
    {
      "id": 10,
      "direction": "in",
      "value_type": "float",
      "channel": { "device": 1, "name": "setpoint" }
    },
    {
      "id": 11,
      "direction": "in",
      "value_type": "float",
      "channel": { "device": 2, "name": "level-raw" }
    },
    {
      "id": 12,
      "direction": "out",
      "value_type": "float",
      "channel": { "device": 1, "name": "valve" }
    }
  ],
  "signals": [
    {
      "id": 100,
      "name": "level-setpoint",
      "source": 10,
      "unit": "m",
      "description": "Tank level setpoint"
    },
    {
      "id": 101,
      "name": "tank-level-raw",
      "source": 11,
      "unit": "mA",
      "description": "Tank level raw measurement, served by the remote simulated plant"
    },
    {
      "id": 102,
      "name": "valve-command",
      "source": 12,
      "unit": "%",
      "description": "Inlet valve command"
    }
  ],
  "components": [
    {
      "id": 1,
      "kind": "analog-input",
      "parameters": {
        "raw_min": { "float": 4.0 },
        "raw_max": { "float": 20.0 },
        "eng_min": { "float": 0.0 },
        "eng_max": { "float": 100.0 }
      },
      "ports": {
        "raw": { "direction": "in", "value_type": "float" },
        "out": { "direction": "out", "value_type": "float" }
      }
    },
    {
      "id": 2,
      "kind": "pid",
      "parameters": {
        "kp": { "float": 0.1 },
        "ki": { "float": 0.1 },
        "kd": { "float": 0.0 },
        "dt": { "float": 0.1 },
        "out_min": { "float": 4.0 },
        "out_max": { "float": 20.0 }
      },
      "ports": {
        "sp": { "direction": "in", "value_type": "float" },
        "pv": { "direction": "in", "value_type": "float" },
        "out": { "direction": "out", "value_type": "float" }
      }
    }
  ],
  "connections": [
    {
      "from": { "point": 10 },
      "to": { "port": { "component": 2, "name": "sp" } }
    },
    {
      "from": { "point": 11 },
      "to": { "port": { "component": 1, "name": "raw" } }
    },
    {
      "from": { "port": { "component": 1, "name": "out" } },
      "to": { "port": { "component": 2, "name": "pv" } }
    },
    {
      "from": { "port": { "component": 2, "name": "out" } },
      "to": { "point": 12 }
    },
    {
      "from": { "point": 11 },
      "to": { "point": 12 }
    }
  ]
}
