      "id": 109,
      "name": "fault-alarm-suppress",
      "source": 19,
      "description": "Designed-suppression condition for the fault alarm"
    },
    {
      "id": 110,
      "name": "level-alarm",
      "source": 20,
      "description": "Standing limit state of the managed level alarm"
    },
    {
      "id": 111,
      "name": "level-alarm-unacknowledged",
      "source": 21,
      "description": "Latched from a fresh level trip until the operator acknowledges"
    },
    {
      "id": 112,
      "name": "level-alarm-shelved",
      "source": 22,
      "description": "Asserts while a shelve request stands inside the declared bound"
    },
    {
      "id": 113,
      "name": "level-alarm-suppressed",
      "source": 23,
      "description": "Asserts while the level alarm's suppress condition holds"
    },
    {
      "id": 114,
      "name": "level-alarm-out-of-service",
      "source": 24,
      "description": "Asserts while the level alarm is out of service"
    },
    {
      "id": 115,
      "name": "station-power-fail",
      "source": 25,
      "description": "Station power failure — the never-shelvable managed alarm's condition"
    },
    {
      "id": 116,
      "name": "power-alarm-ack",
      "source": 26,
      "description": "Operator acknowledgment for the power alarm"
    },
    {
      "id": 117,
      "name": "power-alarm-shelve",
      "source": 27,
      "description": "Shelve request the never-shelvable power alarm binds but never accepts — not writable, so requests reject NotWritable at submission"
    },
    {
      "id": 118,
      "name": "power-alarm-oos",
      "source": 28,
      "description": "Operator out-of-service command for the power alarm"
