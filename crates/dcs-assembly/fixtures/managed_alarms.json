    },
    {
      "id": 125,
      "name": "power-alarm-unacknowledged",
      "source": 41,
      "description": "Latched from a fresh power-fail assertion until the operator acknowledges"
    },
    {
      "id": 126,
      "name": "power-alarm-shelved",
      "source": 42,
      "description": "Never asserts — the declared bound is zero and the bound point is not writable"
    },
    {
      "id": 127,
      "name": "power-alarm-suppressed",
      "source": 43,
      "description": "Never asserts — the instance declares no suppress surface"
    },
    {
      "id": 128,
      "name": "power-alarm-out-of-service",
      "source": 44,
      "description": "Asserts while the power alarm is out of service"
