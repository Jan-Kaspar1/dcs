    },
    {
      "id": 101,
      "name": "level-alarm-ack",
      "source": 11,
      "description": "Operator acknowledgment for the level alarm, held internally until a command writes it"
    },
    {
      "id": 102,
      "name": "level-alarm-shelve",
      "source": 12,
      "description": "Operator shelve request for the level alarm — writable so requests ride the receipted path"
    },
    {
      "id": 103,
      "name": "level-alarm-oos",
      "source": 13,
      "description": "Operator out-of-service command for the level alarm — manual in both directions"
    },
    {
      "id": 104,
      "name": "level-alarm-suppress",
      "source": 14,
      "description": "Designed-suppression condition for the level alarm — wired, so it is a declared input not a mode"
    },
    {
      "id": 105,
      "name": "pump-fault",
      "source": 15,
      "description": "Pump fault flag the managed Bool alarm latches"
    },
    {
