      "required": [
        "device",
        "name"
      ],
      "type": "object"
    },
    "component": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "latching-alarm",
                  "bool-latching-alarm",
                  "managed-latching-alarm",
                  "managed-bool-latching-alarm"
