            "required": [
              "writable"
            ]
          },
          "then": {
            "properties": {
              "direction": {
                "const": "in"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stale_after_ticks": {
                "type": "integer"
              }
            },
            "required": [
              "stale_after_ticks"
            ]
          },
          "then": {
            "properties": {
              "channel": {
                "not": {
                  "type": "null"
                }
              },
              "direction": {
                "const": "in"
              }
            },
            "required": [
              "channel"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "journaled": {
                "const": true
              }
            },
            "required": [
              "journaled"
            ]
          },
          "then": {
            "properties": {
              "value_type": {
                "enum": [
                  "bool",
                  "int"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "initial": {
                "type": "object"
              },
              "value_type": {
                "const": "bool"
              }
            },
            "required": [
              "initial",
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "initial": {
                "$ref": "#/$defs/bool-value"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "initial": {
                "type": "object"
              },
              "value_type": {
                "const": "int"
              }
            },
            "required": [
              "initial",
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "initial": {
                "$ref": "#/$defs/int-value"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "initial": {
                "type": "object"
              },
              "value_type": {
                "const": "float"
              }
            },
            "required": [
              "initial",
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "initial": {
                "$ref": "#/$defs/float-value"
              }
            }
          }
        }
      ],
      "properties": {
        "channel": {
          "anyOf": [
            {
              "$ref": "#/$defs/channel-ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "$ref": "#/$defs/direction"
