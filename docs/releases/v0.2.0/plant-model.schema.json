      "required": [
        "component",
        "name"
      ],
      "type": "object"
    },
    "rationalization": {
      "additionalProperties": false,
      "properties": {
        "consequence": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "required_action": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "consequence",
        "required_action",
        "reference"
      ],
      "type": "object"
    },
    "register-index": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "script-entry": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "reason"
