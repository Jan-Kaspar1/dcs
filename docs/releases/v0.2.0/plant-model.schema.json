                        "type": "object"
                      },
                      "outputs": {
                        "additionalProperties": {
                          "$ref": "#/$defs/image-offset"
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "safe_outputs": {
                    "additionalProperties": {
                      "$ref": "#/$defs/value"
                    },
                    "type": "object"
                  },
                  "startup": {
                    "additionalProperties": false,
                    "properties": {
                      "on_mismatch": {
                        "const": "fail"
                      }
                    },
                    "required": [
                      "on_mismatch"
