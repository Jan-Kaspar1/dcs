    "int-value": {
      "additionalProperties": false,
      "properties": {
        "int": {
          "type": "integer"
        }
      },
      "required": [
        "int"
      ],
      "type": "object"
    },
    "io-point": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "channel"
                  ]
                }
              },
              {
                "properties": {
                  "channel": {
                    "type": "null"
                  }
                },
                "required": [
                  "channel"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "initial": {
                "$ref": "#/$defs/value"
              }
            },
            "required": [
              "initial"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "properties": {
              "initial": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "writable": {
                "const": true
              }
