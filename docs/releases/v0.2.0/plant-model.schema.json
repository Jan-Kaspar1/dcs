  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The versioned plant-model document: devices, logical io_points, signals, components, and connections. The schema covers structure, field types, and intra-element rules; cross-reference and wiring checks remain with the Rust validator (docs/architecture.md).",
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/component"
      },
      "type": "array",
      "uniqueItems": true
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/connection"
      },
      "type": "array"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/device"
      },
      "type": "array",
      "uniqueItems": true
    },
    "io_points": {
      "items": {
        "$ref": "#/$defs/io-point"
      },
      "type": "array",
      "uniqueItems": true
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/signal"
      },
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "devices",
    "io_points",
    "signals",
    "components",
    "connections"
  ],
  "title": "DCS plant model",
  "type": "object"
}
