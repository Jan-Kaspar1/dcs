    "u32-int": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/bool-value"
        },
        {
          "$ref": "#/$defs/int-value"
        },
        {
          "$ref": "#/$defs/float-value"
        }
      ]
    },
    "value-kind": {
      "enum": [
        "bool",
        "int",
        "float"
      ]
    }
