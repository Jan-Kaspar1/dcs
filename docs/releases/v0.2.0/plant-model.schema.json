          "then": {
            "properties": {
              "parameters": {
                "properties": {
                  "class": {
                    "$ref": "#/$defs/nonneg-int-value"
                  },
                  "priority": {
                    "$ref": "#/$defs/nonneg-int-value"
                  },
                  "response_ticks": {
                    "$ref": "#/$defs/nonneg-int-value"
                  }
                },
                "required": [
                  "priority",
                  "class",
                  "response_ticks"
                ]
              },
              "rationalization": {
                "$ref": "#/$defs/rationalization"
              }
            },
            "required": [
              "rationalization"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/value"
          },
          "type": "object"
        },
        "ports": {
          "additionalProperties": {
