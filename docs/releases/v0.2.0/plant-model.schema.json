                    "type": "object"
                  }
                },
                "required": [
                  "bus",
                  "identity",
                  "mapping",
                  "exchange_miss_threshold",
                  "startup"
                ],
                "type": "object"
              }
            },
            "required": [
              "hardware",
              "parameters"
            ]
          }
        }
      ],
      "properties": {
        "channels": {
          "additionalProperties": {
            "$ref": "#/$defs/endpoint-shape"
          },
          "type": "object"
        },
        "hardware": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "channels"
      ],
      "type": "object"
    },
    "direction": {
      "enum": [
        "in",
        "out"
