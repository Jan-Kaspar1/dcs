                      "type": "array"
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "script"
                ],
                "type": "object"
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ethercat"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "hardware": {
                "const": true
              },
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "bus": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "exchange_miss_threshold": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "identity": {
                    "additionalProperties": false,
                    "properties": {
                      "product": {
                        "$ref": "#/$defs/u32-int"
                      },
                      "revision": {
                        "$ref": "#/$defs/u32-int"
                      },
                      "vendor": {
                        "$ref": "#/$defs/u32-int"
                      }
                    },
                    "required": [
                      "vendor",
                      "product",
                      "revision"
