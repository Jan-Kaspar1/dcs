            {
              "type": "null"
            }
          ]
        },
        "journaled": {
          "type": "boolean"
        },
        "stale_after_ticks": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonneg-int"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_type": {
          "$ref": "#/$defs/value-kind"
        },
        "writable": {
          "type": "boolean"
        }
