                                "$ref": "#/$defs/value"
                              },
                              "register": {
                                "$ref": "#/$defs/register-index"
                              }
                            },
                            "required": [
                              "register"
                            ],
                            "type": "object"
                          }
                        ]
                      },
                      "minProperties": 1,
                      "type": "object"
                    },
                    "minProperties": 1,
                    "type": "object"
                  },
                  "timeout_ms": {
                    "$ref": "#/$defs/nonneg-int"
                  }
                },
                "required": [
                  "address",
                  "exchange_miss_threshold",
                  "stations"
                ],
                "type": "object"
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sim-scripted"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "script": {
                    "additionalProperties": {
                      "items": {
                        "$ref": "#/$defs/script-entry"
