          "then": {
            "properties": {
              "quality": {
                "enum": [
                  "uncertain",
                  "bad"
                ]
              }
            },
            "required": [
              "quality"
            ]
          }
        }
      ],
      "properties": {
        "quality": {
          "enum": [
            "good",
            "uncertain",
            "bad"
          ]
        },
        "reason": {
          "enum": [
            "unspecified",
            "substituted",
            "stale",
            "out_of_range",
            "communication_fault",
            "device_fault",
            "configuration_fault"
          ]
        },
        "tick": {
          "$ref": "#/$defs/nonneg-int"
        },
        "value": true
      },
      "required": [
        "tick",
        "value"
      ],
      "type": "object"
    },
    "signal": {
      "additionalProperties": false,
      "properties": {
